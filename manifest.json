{
  "manifest_version": 3,
  "name": "Roblox Game Creator",
  "version": "2.0.0",
  "description": "Pick a .rbxl file and this creates a brand-new Roblox game from it, using the account you're signed into.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Roblox Game Creator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://*.roblox.com/*"]
}
